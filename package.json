{
  "name": "timetracker",
  "version": "1.0.33",
  "description": "Time tracking for customers and projects",
  "main": "src/main.js",
  "author": {
    "name": "Nimble Panda Ltd",
    "email": "hello@nimblepanda.co.uk"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:all": "electron-builder --win --x64 --arm64"
  },
  "build": {
    "appId": "com.timetracker.app",
    "productName": "TimeTracker",
    "copyright": "Copyright © 2025-2026 Nimble Panda Ltd",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/**/*.map"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TimeTracker",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "TimeTracker-${version}-portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "WaterhouseA-Programming",
      "repo": "timetracker",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
